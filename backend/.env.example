# Copy to .env and fill in. Never commit .env.

# --- credentials ---------------------------------------------------------
GROQ_API_KEY=
MISTRAL_API_KEY=

# --- models --------------------------------------------------------------
# Which provider the agent uses by default: groq | mistral
DEFAULT_MODEL_PROVIDER=groq

# Model identifiers are not defaulted in code — set ones your account can use.
# Both defaults below support tool calling, which the agent requires.
# Groq: https://console.groq.com/docs/models
# Mistral: https://docs.mistral.ai/getting-started/models/
GROQ_MODEL=llama-3.1-8b-instant
MISTRAL_MODEL=mistral-small-latest
MODEL_TEMPERATURE=0.0

# --- server --------------------------------------------------------------
# Keep this on the loopback address: the agent can act on your Mac.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# The Next.js dev server. Added to the allowed CORS origins; a wildcard is
# never used.
FRONTEND_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- agent runtime -------------------------------------------------------
AGENT_MAX_ITERATIONS=6
REQUEST_TIMEOUT_SECONDS=60

# How long a CONFIRM tool waits for the user to approve or deny before the
# request expires and the agent moves on.
PERMISSION_TIMEOUT_SECONDS=300

# --- mcp -----------------------------------------------------------------
# Defaults to the NEXUS Mac MCP server (the nexus-mac-mcp project, installed
# into this environment), launched with this venv's Python over stdio.
# Override to point at a different local MCP server.
# MCP_SERVER_COMMAND=
# MCP_SERVER_ARGS=-m,nexus_mac_mcp

# --- logging -------------------------------------------------------------
LOG_LEVEL=INFO

# --- mission context budget -----------------------------------------------
# What the planner is allowed to see of memory/workspace/machine state.
CONTEXT_MAX_MEMORIES=10
CONTEXT_MAX_WORKSPACE_FACTS=20
CONTEXT_MAX_CHARS=4000
