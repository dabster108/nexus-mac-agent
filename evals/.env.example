# Copy to .env and fill in. Never commit .env.
#
#   cp .env.example .env
#   uv run python -m src --check

# --- Langfuse ------------------------------------------------------------
# Cloud: https://cloud.langfuse.com → Project → Settings → API Keys
#   or EU: https://cloud.langfuse.com  /  US: https://us.cloud.langfuse.com
# Self-host: point LANGFUSE_HOST at your instance.
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com
# Shown as the environment filter in the Langfuse UI (dev / staging / prod).
LANGFUSE_ENVIRONMENT=dev

# --- NEXUS backend -------------------------------------------------------
# The running NEXUS backend that evals will drive over HTTP.
NEXUS_API_URL=http://127.0.0.1:8000
