# Copy to .env and fill in. Never commit .env.
#
# Day 1 (no Langfuse yet):
#   uv run python -m src --dry-run --approve
#
# Later (with keys):
#   uv run python -m src --check
#   uv run python -m src --approve

# --- Langfuse (optional until you drop --dry-run) ------------------------
# Cloud: https://cloud.langfuse.com → Project → Settings → API Keys
#   or EU: https://cloud.langfuse.com  /  US: https://us.cloud.langfuse.com
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENVIRONMENT=dev

# --- NEXUS backend (required for every run) ------------------------------
NEXUS_API_URL=http://127.0.0.1:8000
