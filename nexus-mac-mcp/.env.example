# NEXUS Mac MCP configuration.
#
# Two things are deliberately NOT configurable here:
#
#   * a network bind address — this is a local capability server, started by
#     the NEXUS backend as a child process and spoken to over stdio. It has no
#     listener and must not be given one.
#   * extra directories to launch applications from — widening that set widens
#     what the agent can start, so it stays in code and under review.
#
# Permission levels are declared per tool in
# src/nexus_mac_mcp/core/permissions.py and enforced by the backend.

# --- filesystem boundary -------------------------------------------------
# Comma-separated roots the filesystem and Git tools may touch. Every path is
# resolved (symlinks and '..' included) before it is checked, so nothing can
# step outside these. Defaults to the user's home directory.
#
# Narrow this to your projects directory if you want a tighter boundary:
#   NEXUS_MAC_ALLOWED_ROOTS=~/Projects,~/Documents
NEXUS_MAC_ALLOWED_ROOTS=~

# --- output limits -------------------------------------------------------
# These protect the model's context window as much as the machine.
NEXUS_MAC_MAX_FILE_BYTES=100000
NEXUS_MAC_MAX_ENTRIES=200
NEXUS_MAC_MAX_MATCHES=50
NEXUS_MAC_MAX_DEPTH=8

# --- command execution ---------------------------------------------------
# Bounds on `run_command`. Output above the limit is truncated and flagged;
# a command past the timeout has its whole process group terminated.
NEXUS_MAC_MAX_OUTPUT_BYTES=100000
NEXUS_MAC_COMMAND_TIMEOUT=120

# Where executables are looked up. A fixed list, not the caller's PATH, so a
# name cannot be shadowed by something earlier in the path.
# NEXUS_MAC_COMMAND_PATH=/usr/bin:/bin:/usr/local/bin:/opt/homebrew/bin:~/.local/bin:~/.npm-global/bin

# --- managed processes ---------------------------------------------------
# Long-running development servers started with start_process. Output is held
# in a ring buffer per stream, so a server can log indefinitely without growing
# without bound. Everything started is terminated when this server exits.
# (Limits are currently compile-time: 200KB per stream, 8 concurrent processes.)

# --- memory ----------------------------------------------------------------
# SQLite database location. Defaults to ~/.nexus/nexus.db — outside any
# project workspace. Override only for tests/isolation.
# NEXUS_MAC_DB_PATH=
